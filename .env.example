# ============================================================
# Tuling-Ai 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================================


# ============================================================
# 1. 模型 API 配置（必填，选择一个提供商即可）
# ============================================================

# --- 阿里云 DashScope（推荐） ---
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- 智谱 AI ---
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# --- 腾讯混元 ---
# HUNYUAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# --- DeepSeek ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- 通用 OpenAI 兼容文本模型（优先级最高，可选） ---
# TEXT_MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TEXT_MODEL_BASE_URL=https://example.com/v1
# TEXT_MODEL_MODEL=model-name


# ============================================================
# 2. 数据库配置（必填）
# ============================================================

# PostgreSQL 连接串（用于 LangGraph checkpointer 和长期记忆）
# 格式：postgresql+psycopg://用户名:密码@主机:端口/数据库名
POSTGRES_URL=postgresql+psycopg://postgres:123456@127.0.0.1:5432/langgraph_agents

# PostgreSQL 连接串（纯 postgresql 协议，供 LangGraph SDK 使用）
LANGGRAPH_POSTGRES_DSN=postgresql://postgres:123456@127.0.0.1:5432/langgraph_agents?sslmode=disable


# ============================================================
# 3. 服务端口配置（可选，使用默认值即可）
# ============================================================

# RAG API 服务
# RAG_API_HOST=0.0.0.0
# RAG_API_PORT=8011

# MCP 服务
# MCP_SERVICE_URL=http://127.0.0.1:8010/mcp

# LangGraph 服务
# LANGGRAPH_API_URL=http://127.0.0.1:2024
# LANGGRAPH_ASSISTANT_ID=multi_agent

# RAG API 完整地址
# RAG_API_URL=http://127.0.0.1:8011/api/docs

# main_service 后台运行时关闭热重载；开发时可设为 true
# MAIN_SERVICE_RELOAD=false


# ============================================================
# 4. JWT 鉴权配置（可选，建议修改）
# ============================================================

# JWT 密钥（生产/多实例必须配置；本地缺省时会生成进程级临时密钥）
# JWT_SECRET_KEY=your-super-secret-key-change-me

# JWT 算法
# JWT_ALGORITHM=HS256

# Token 过期时间（分钟）
# ACCESS_TOKEN_EXPIRE_MINUTES=120

# 刷新 Token 过期时间（天）
# REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# 5. 模型参数配置（可选）
# ============================================================

# 模型温度参数（0.0-1.0，越低越确定性）
# MODEL_TEMPERATURE=0.1


# ============================================================
# 6. RAG 配置
# ============================================================

# RAG 后端默认且推荐使用独立 RAGFlow 服务。
# legacy 只有在显式安装旧依赖并同时开启安全开关后才允许启动。
RAG_BACKEND=ragflow
ENABLE_LEGACY_RAG=false

# 本地微服务调用必须绕过系统/VPN HTTP 代理
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# --- RAGFlow（RAG_BACKEND=ragflow 时必填） ---
# RAGFlow Cloud：无需本地 Docker
# RAGFLOW_BASE_URL=https://cloud.ragflow.io
# 自托管地址示例：RAGFLOW_BASE_URL=http://127.0.0.1:9380

# 在 RAGFlow 用户设置中创建的 API Key
# RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 用于本项目知识库的 RAGFlow Dataset ID
# RAGFLOW_DATASET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RAGFlow 请求超时（秒）
# RAGFLOW_TIMEOUT_SECONDS=120

# 召回参数
# RAGFLOW_SIMILARITY_THRESHOLD=0.2
# RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3
# RAGFLOW_TOP_K=8

# 可选的 RAGFlow Rerank 模型 ID
# RAGFLOW_RERANK_ID=

# 送入答案生成模型的最大检索上下文字符数
# RAGFLOW_GENERATION_MAX_CONTEXT_CHARS=24000

# --- Legacy RAG（RAG_BACKEND=legacy 时使用） ---

# Embedding 模型路径（本地模型路径或 HuggingFace 模型名）
# EMBEDDING_MODEL_PATH=D:\llm\Local_model\BAAI\bge-small-zh-v1___5

# Rerank 模型路径
# RERANK_MODEL_PATH=D:\llm\Local_model\BAAI\bge-reranker-large

# 文本分块大小
# CHUNK_SIZE=512

# 分块重叠大小
# CHUNK_OVERLAP=50

# 向量检索返回数量
# SIMILARITY_TOP_K=5

# 重排后保留数量
# RERANK_TOP_K=3


# ============================================================
# 7. 第三方服务 API（可选，用于增强功能）
# ============================================================

# Tavily 搜索 API（知识库兜底搜索）
# 申请地址：https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace Token（下载模型用）
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 天气 API（可选）
# WEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps API（可选）
# GMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LangSmith API（可选，用于调试追踪）
# 申请地址：https://smith.langchain.com
# LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
# 8. Redis 配置（可选，使用默认值即可）
# ============================================================

# Redis 连接地址（rag_api_service 使用）
# 默认连接 127.0.0.1:6379，无需密码
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=


# ============================================================
# 配置说明
# ============================================================
#
# 必填配置：
#   1. DASHSCOPE_API_KEY 或其他模型 API Key（至少配置一个）
#   2. POSTGRES_URL（PostgreSQL 连接串）
#   3. 使用 RAGFlow 时需配置 RAGFLOW_API_KEY 和 RAGFLOW_DATASET_ID
#
# 可选配置：
#   - 其他模型 API Key（用于切换模型提供商）
#   - JWT_SECRET_KEY（本地不设置会生成临时密钥；生产/多实例必须设置）
#   - TAVILY_API_KEY（不设置则知识库兜底搜索功能不可用）
#   - RAG 配置（使用默认值即可，根据文档特点可调整）
#
# 端口配置：
#   - 所有服务端口都有默认值，一般无需修改
#   - 如有端口冲突，可取消注释并修改对应配置
#
# ============================================================
